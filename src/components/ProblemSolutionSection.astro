---
import DashboardPreview from './DashboardPreview';
---

<section class="py-24 md:py-32 bg-surface-base border-t border-neutral-200 relative overflow-hidden problem-solution-section">

  <div class="page-container relative z-10 w-full max-w-[1400px] mx-auto px-6 flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
    
    <!-- Text Content -->
    <div class="flex-1 lg:max-w-xl text-content flex flex-col justify-center">
      
      <div class="mb-12">
        <h2 class="text-[10px] font-tech text-[#A0A3A8] uppercase tracking-[0.3em] mb-4 flex items-center gap-4">
          <span class="w-6 h-px bg-[#A0A3A8]"></span>
          01 // THE PROBLEM
        </h2>
        <p class="text-3xl md:text-4xl lg:text-[2.5rem] font-display font-medium text-neutral-900 leading-[1.3] tracking-tight">
          Businesses waste money on generic software suites, paying for <span class="text-[#8a8a93] line-through decoration-[#3A3B3C]">features they never use</span> while struggling with disconnected tools.
        </p>
      </div>

      <div class="mb-10">
        <h2 class="text-[10px] font-tech text-brand-primary uppercase tracking-[0.3em] mb-4 flex items-center gap-4">
          <span class="w-6 h-px bg-brand-primary"></span>
          02 // THE SOLUTION
        </h2>
        <p class="text-3xl md:text-4xl lg:text-[2.5rem] font-display font-medium text-neutral-900 leading-[1.3] tracking-tight">
          We deploy a <span class="text-brand-primary">custom dashboard</span> for your operations. Install only the tools you need, and <span class="text-brand-primary">pay only for what you use.</span>
        </p>
      </div>
      
      <div class="pt-6">
        <a href="/login" class="group flex items-center gap-4 text-[11px] font-tech uppercase tracking-[0.2em] text-neutral-900 hover:text-brand-primary transition-colors w-fit">
          Explore Custom Tools
          <div class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center group-hover:border-brand-primary group-hover:bg-brand-primary/10 transition-all shadow-[0_0_15px_rgba(27,80,249,0)] group-hover:shadow-[0_0_15px_rgba(27,80,249,0.2)]">
             <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
      </div>
    </div>

    <!-- Dashboard Parallax Widget -->
    <div class="hidden md:block flex-1 w-full relative [perspective:1200px] dashboard-parallax-wrapper h-[400px] sm:h-[500px]">
       <div class="absolute -inset-10 bg-brand-primary/10 blur-[100px] rounded-full pointer-events-none dashboard-glow"></div>
       <div class="shadow-2xl dashboard-element w-full h-full absolute inset-0">
          <DashboardPreview client:visible />
       </div>
    </div>
    
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  // Make sure GSAP runs only on client
  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    // Parallax and fade-in animations for the section
    const section = document.querySelector('.problem-solution-section');
    
    if (section) {
      const textContent = section.querySelector('.text-content');
      const dashboardElement = section.querySelector('.dashboard-element');
      const dashboardGlow = section.querySelector('.dashboard-glow');

      // Fade in text
      gsap.from(textContent, {
        scrollTrigger: {
          trigger: section,
          start: 'top 80%',
        },
        y: 30,
        opacity: 0,
        duration: 1,
        ease: 'power3.out'
      });

      // Dramatic Parallax effect on dashboard
      gsap.fromTo(dashboardElement, 
        {
          y: 100,
          scale: 0.95
        },
        {
          scrollTrigger: {
            trigger: section,
            start: 'top bottom', // Start when the section enters the viewport
            end: 'bottom top',   // End when the section leaves the viewport
            scrub: 1, // Smooth scrubbing
          },
          y: -100,
          scale: 1.05,
          ease: 'none'
        }
      );

      // Pulse the glow
      gsap.to(dashboardGlow, {
        opacity: 0.7,
        scale: 1.1,
        duration: 2.5,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut'
      });
    }
  }
</script>
