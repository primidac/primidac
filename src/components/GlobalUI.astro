---
---
<!-- Toast Notification -->
<div id="global-toast" class="fixed bottom-6 right-6 translate-y-20 opacity-0 pointer-events-none transition-all duration-300 z-50">
  <div id="toast-content" class="bg-white text-neutral-900 border border-neutral-200 px-6 py-3 rounded shadow-xl font-mono text-sm flex items-center gap-3">
    <span id="toast-icon" class="w-4 h-4"></span>
    <span id="toast-message">Notification</span>
  </div>
</div>

<!-- Confirm Modal -->
<div id="global-confirm" class="fixed inset-0 z-[100] hidden items-center justify-center bg-neutral-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-200">
  <div class="bg-white rounded p-8 max-w-sm w-full mx-4 shadow-2xl transform scale-95 transition-transform duration-200" id="confirm-box">
    <h3 class="font-bold font-sans text-xl mb-2 text-neutral-900" id="confirm-title">Confirm Action</h3>
    <p id="confirm-message" class="text-sm font-sans text-neutral-600 mb-8 leading-relaxed">Are you sure you want to proceed?</p>
    <div class="flex justify-end gap-3">
      <button id="btn-confirm-cancel" class="px-5 py-2 text-sm font-mono uppercase tracking-widest text-neutral-500 hover:text-neutral-900 transition-colors">Cancel</button>
      <button id="btn-confirm-ok" class="px-5 py-2 text-sm font-mono uppercase tracking-widest bg-white text-neutral-900 border border-neutral-200 rounded hover:bg-neutral-100 transition-colors">OK</button>
    </div>
  </div>
</div>

<script>
  let toastTimeout: number;

  window.showToast = (message: string, type: 'success' | 'error' | 'info' = 'success') => {
    const toast = document.getElementById('global-toast');
    const msgEl = document.getElementById('toast-message');
    const iconEl = document.getElementById('toast-icon');
    
    if (!toast || !msgEl || !iconEl) return;
    
    msgEl.innerText = message;
    
    // Set icon and colors based on type
    if (type === 'success') {
      iconEl.className = 'i-lucide-check-circle w-4 h-4 text-green-400';
    } else if (type === 'error') {
      iconEl.className = 'i-lucide-alert-circle w-4 h-4 text-red-400';
    } else {
      iconEl.className = 'i-lucide-info w-4 h-4 text-blue-400';
    }

    toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
    
    clearTimeout(toastTimeout);
    toastTimeout = window.setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
    }, 3000) as unknown as number;
  };

  let activeConfirmCallback: (() => void) | null = null;

  window.showConfirm = (message: string, onConfirm: () => void) => {
    const modal = document.getElementById('global-confirm');
    const msgEl = document.getElementById('confirm-message');
    const box = document.getElementById('confirm-box');
    
    if (!modal || !msgEl || !box) return;
    
    msgEl.innerText = message;
    activeConfirmCallback = onConfirm;
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    // small delay for transition
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      box.classList.remove('scale-95');
    }, 10);
  };

  function closeConfirm() {
    const modal = document.getElementById('global-confirm');
    const box = document.getElementById('confirm-box');
    if (!modal || !box) return;
    
    modal.classList.add('opacity-0');
    box.classList.add('scale-95');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      activeConfirmCallback = null;
    }, 200);
  }

  document.getElementById('btn-confirm-cancel')?.addEventListener('click', closeConfirm);
  
  document.getElementById('btn-confirm-ok')?.addEventListener('click', () => {
    if (activeConfirmCallback) {
      activeConfirmCallback();
    }
    closeConfirm();
  });
</script>
