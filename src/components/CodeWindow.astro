---
interface Props {
  filename?: string;
}

const {
  filename = "verify-webhook.ts",
} = Astro.props;
---

<div class="code-window bg-[#161616] text-[#F4F1EA] rounded-lg border border-[rgba(22,22,22,0.18)] dark:border-[rgba(242,239,232,0.15)] shadow-md overflow-hidden font-mono text-[13px] leading-relaxed">
  <!-- Window Header Bar -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-[#1F1F1D] border-b border-[rgba(255,255,255,0.08)] select-none">
    <div class="flex items-center gap-2">
      <div class="w-2.5 h-2.5 rounded-full bg-[#E8788A]/80"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#E8E5DD]/30"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#E8E5DD]/30"></div>
      <span class="ml-2 text-xs text-neutral-400 font-mono flex items-center gap-1.5">
        <span class="text-accent text-[11px]">//</span> {filename}
      </span>
    </div>
    <div class="text-[11px] text-neutral-400 font-mono tracking-wider flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>READY</span>
    </div>
  </div>

  <!-- Code Content with Line Numbers -->
  <div class="p-4 sm:p-5 overflow-x-auto text-[12.5px] sm:text-[13px] font-mono leading-6">
    <pre class="m-0 text-[#E8E5DD]"><code id="code-content"><span class="text-neutral-500">// @primidac — Constant-time signature verification</span>
<span class="text-[#E8788A]">import</span> &#123; createHmac, timingSafeEqual &#125; <span class="text-[#E8788A]">from</span> <span class="text-emerald-300">'node:crypto'</span>;

<span class="text-[#E8788A]">export async function</span> <span class="text-blue-300">verifyWebhook</span>(
  payload: Buffer,
  sigHeader: string,
  secret: string
): Promise&lt;&#123; verified: boolean; error?: string &#125;&gt; &#123;
  <span class="text-[#E8788A]">try</span> &#123;
    <span class="text-[#E8788A]">const</span> computed = createHmac(<span class="text-emerald-300">'sha256'</span>, secret)
      .update(payload)
      .digest(<span class="text-emerald-300">'hex'</span>);

    <span class="text-[#E8788A]">const</span> a = Buffer.from(sigHeader, <span class="text-emerald-300">'hex'</span>);
    <span class="text-[#E8788A]">const</span> b = Buffer.from(computed, <span class="text-emerald-300">'hex'</span>);

    <span class="text-[#E8788A]">if</span> (a.length !== b.length) &#123;
      <span class="text-[#E8788A]">return</span> &#123; verified: <span class="text-[#E8788A]">false</span>, error: <span class="text-emerald-300">'Length mismatch'</span> &#125;;
    &#125;

    <span class="text-neutral-500">// Mitigate side-channel timing attacks</span>
    <span class="text-[#E8788A]">const</span> isValid = timingSafeEqual(a, b);
    <span class="text-[#E8788A]">return</span> &#123; verified: isValid &#125;;
  &#125; <span class="text-[#E8788A]">catch</span> (err) &#123;
    <span class="text-[#E8788A]">return</span> &#123; verified: <span class="text-[#E8788A]">false</span>, error: <span class="text-emerald-300">'Verification failed'</span> &#125;;
  &#125;
&#125;</code></pre>
  </div>

  <!-- Terminal Status Footer -->
  <div class="px-4 py-2 bg-[#121212] border-t border-[rgba(255,255,255,0.06)] flex items-center justify-between text-[11px] text-neutral-400 font-mono">
    <div class="flex items-center gap-2">
      <span class="text-accent">&gt;</span>
      <span>crypto.timingSafeEqual: OK</span>
    </div>
    <div class="text-[10px] text-neutral-500 uppercase tracking-wider">
      TypeScript 5.x
    </div>
  </div>
</div>
