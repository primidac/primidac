---
import "../styles/global.css";
import GlobalUI from "../components/GlobalUI.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title} — Primidac Admin</title>
  </head>
  <body
    class="bg-surface-base font-sans antialiased text-neutral-900 min-h-screen flex"
  >
    <!-- Mobile Overlay -->
    <div
      id="admin-mobile-overlay"
      class="fixed inset-0 bg-neutral-900/50 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity opacity-0"
    >
    </div>

    <!-- Sidebar Navigation -->
    <aside
      id="admin-sidebar"
      class="w-64 border-r border-neutral-200 bg-white flex flex-col h-screen fixed inset-y-0 left-0 z-50 transform -translate-x-full lg:translate-x-0 lg:sticky lg:top-0 transition-transform duration-300 ease-in-out"
    >
      <div
        class="p-6 border-b border-neutral-200 flex justify-between items-center"
      >
        <a href="/admin/dashboard" class="flex items-center gap-3">
          <img
            src="/logo.png"
            alt="Primidac"
            class="h-6 w-auto object-contain"
          />
          <span
            class="font-bold text-xs tracking-[0.2em] uppercase text-neutral-900"
            >Admin</span
          >
        </a>
        <button
          id="admin-close-sidebar"
          class="lg:hidden text-neutral-500 hover:text-neutral-900"
        >
          <span class="i-lucide-x w-5 h-5"></span>
        </button>
      </div>

      <nav class="flex-1 px-4 py-6 flex flex-col gap-1 overflow-y-auto">
        <a
          href="/admin/dashboard"
          class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/dashboard") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
        >
          <span class="i-lucide-layout-dashboard w-4 h-4"></span>
          Overview
        </a>
        <a
          href="/admin/crm"
          class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/crm") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
        >
          <span class="i-lucide-users w-4 h-4"></span>
          CRM Pipeline
        </a>
        <a
          href="/admin/portfolio"
          class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/portfolio") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
        >
          <span class="i-lucide-briefcase w-4 h-4"></span>
          Portfolio
        </a>
        <a
          href="/admin/insights"
          class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/insights") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
        >
          <span class="i-lucide-file-text w-4 h-4"></span>
          Insights CMS
        </a>
        <a
          href="/admin/media"
          class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/media") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
        >
          <span class="i-lucide-image w-4 h-4"></span>
          Media Library
        </a>
        <a
          href="/admin/invoices"
          class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/invoices") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
        >
          <span class="i-lucide-receipt w-4 h-4"></span>
          Invoices
        </a>
        <div class="mt-auto pt-4">
          <a
            href="/admin/settings"
            class={`px-4 py-3 text-xs font-mono tracking-widest uppercase hover:bg-neutral-50 hover:text-brand-primary transition-colors flex items-center gap-3 rounded ${currentPath.includes("/admin/settings") ? "bg-brand-primary/10 text-brand-primary" : "text-neutral-500"}`}
          >
            <span class="i-lucide-settings w-4 h-4"></span>
            Settings
          </a>
        </div>
      </nav>

      <div class="p-4 border-t border-neutral-200">
        <button
          id="admin-logout-btn"
          class="w-full px-4 py-3 text-xs font-mono tracking-widest text-neutral-500 hover:text-red-500 hover:bg-red-50 transition-colors uppercase text-left flex items-center gap-3 rounded"
        >
          <span class="i-lucide-log-out w-4 h-4"></span>
          Logout
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main
      class="flex-1 flex flex-col h-screen overflow-y-auto relative bg-surface-base w-full"
    >
      <!-- Mobile Header -->
      <header
        class="lg:hidden bg-white border-b border-neutral-200 p-4 flex items-center justify-between sticky top-0 z-30"
      >
        <div class="flex items-center gap-3">
          <img
            src="/logo.png"
            alt="Primidac"
            class="h-5 w-auto object-contain"
          />
          <span
            class="font-bold text-[10px] tracking-[0.2em] uppercase text-neutral-900"
            >Admin</span
          >
        </div>
        <button id="admin-open-sidebar" class="text-neutral-900 p-1">
          <span class="i-lucide-menu w-6 h-6"></span>
        </button>
      </header>

      <!-- Auth check script -->
      <script>
        import { onAuthStateChanged, signOut } from "firebase/auth";
        import { auth } from "../lib/firebase";

        // Listen for auth state
        onAuthStateChanged(auth, (user) => {
          if (!user) {
            window.location.href = "/admin/login";
          }
        });

        // Logout
        const logoutBtn = document.getElementById("admin-logout-btn");
        if (logoutBtn) {
          logoutBtn.addEventListener("click", async () => {
            await signOut(auth);
            window.location.href = "/admin/login";
          });
        }

        // Mobile Sidebar Toggle
        const sidebar = document.getElementById("admin-sidebar");
        const overlay = document.getElementById("admin-mobile-overlay");
        const openBtn = document.getElementById("admin-open-sidebar");
        const closeBtn = document.getElementById("admin-close-sidebar");

        function openSidebar() {
          sidebar?.classList.remove("-translate-x-full");
          overlay?.classList.remove("hidden");
          setTimeout(() => {
            overlay?.classList.remove("opacity-0");
          }, 10);
        }

        function closeSidebar() {
          sidebar?.classList.add("-translate-x-full");
          overlay?.classList.add("opacity-0");
          setTimeout(() => {
            overlay?.classList.add("hidden");
          }, 300); // match transition duration
        }

        openBtn?.addEventListener("click", openSidebar);
        closeBtn?.addEventListener("click", closeSidebar);
        overlay?.addEventListener("click", closeSidebar);
      </script>

      <slot />
      <GlobalUI />
    </main>
  </body>
</html>
