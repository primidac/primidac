---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlobalUI from '../components/GlobalUI.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
}

const { title, description, ogImage, ogType, robots } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800;900&family=Orbitron:wght@400;500;700;900&display=swap" rel="stylesheet" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      robots={robots}
    />
    
    <!-- Retro Pixel Cursor -->
    <style is:global>
      @media (pointer: fine) {
        body, html {
          cursor: url('data:image/svg+xml;utf8,<svg width="18" height="24" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges"><path d="M0,0 L0,15 L4,11 L6,16 L9,15 L7,10 L11,10 Z" fill="white" stroke="black" stroke-width="1" transform="scale(1.2)"/></svg>') 0 0, auto;
        }
        a, button, input, [role="button"], .group {
          cursor: url('data:image/svg+xml;utf8,<svg width="22" height="24" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges"><path d="M6,12 L6,2 C6,1 8,1 8,2 L8,7 L9,7 L9,3 C9,2 11,2 11,3 L11,7 L12,7 L12,4 C12,3 14,3 14,4 L14,7 L15,7 L15,5 C15,4 17,4 17,5 L17,14 L11,20 L5,20 L1,15 L1,12 L6,12 Z" fill="white" stroke="black" stroke-width="1" transform="scale(1.1)"/></svg>') 6 2, pointer !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col relative font-sans antialiased overflow-x-hidden">
    
    <!-- Header Navigation -->
    <Header />

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Motion Engine Initialization -->
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
    <script>
      import { initHeader } from '../scripts/header';
      initHeader();
    </script>
    <script>
      import { trackPageView } from '../scripts/analytics';
      trackPageView();
    </script>
    <GlobalUI />
  </body>
</html>
