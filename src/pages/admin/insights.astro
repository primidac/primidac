---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Insights CMS">
  <div class="p-8 md:p-12 max-w-6xl mx-auto w-full flex flex-col h-full">
    
    <div class="flex justify-between items-end mb-8 shrink-0">
      <div>
        <h1 class="text-2xl font-sans font-bold text-neutral-900 mb-2">Insights Content Management</h1>
        <p class="text-sm text-neutral-500 font-mono tracking-widest uppercase">Publish and manage engineering articles</p>
      </div>
      <button id="btn-new-article" class="btn-primary py-2 px-6">
        <span class="flex items-center gap-2">
          <span class="i-lucide-plus w-4 h-4"></span> New Article
        </span>
      </button>
    </div>

    <!-- Main Views -->
    <div class="bg-white border border-neutral-200 flex-1 flex flex-col overflow-hidden relative">
      
      <!-- List View -->
      <div id="view-list" class="flex-1 overflow-y-auto overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[600px]">
          <thead>
            <tr class="bg-white border-b border-neutral-200">
              <th class="px-6 py-4 text-xs font-mono font-bold text-neutral-500 uppercase tracking-widest w-1/2">Title</th>
              <th class="px-6 py-4 text-xs font-mono font-bold text-neutral-500 uppercase tracking-widest">Status</th>
              <th class="px-6 py-4 text-xs font-mono font-bold text-neutral-500 uppercase tracking-widest">Date</th>
              <th class="px-6 py-4 text-xs font-mono font-bold text-neutral-500 uppercase tracking-widest text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="articles-tbody">
            {Array(5).fill(0).map(() => (
              <tr class="border-b border-neutral-100 animate-pulse">
                <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-3/4"></div></td>
                <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-1/3"></div></td>
                <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-1/2"></div></td>
                <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-16 ml-auto"></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Editor View (Hidden by default) -->
      <div id="view-editor" class="hidden flex-1 flex flex-col h-full bg-white absolute inset-0 z-10">
        <div class="p-4 border-b border-neutral-200 flex justify-between items-center bg-white shrink-0">
          <button id="btn-back" class="text-xs font-mono text-neutral-500 hover:text-neutral-900 uppercase tracking-widest flex items-center gap-2">
            <span class="i-lucide-arrow-left w-4 h-4"></span> Back
          </button>
          <div class="flex items-center gap-4">
            <span id="editor-status" class="text-xs font-mono text-neutral-500">Draft</span>
            <button id="btn-ai-generate" class="text-brand-primary bg-brand-primary/10 hover:bg-brand-primary/20 py-1.5 px-4 text-xs font-mono font-bold flex items-center gap-2 transition-colors">
              <span class="i-lucide-sparkles w-3.5 h-3.5"></span> AI Write
            </button>
            <button id="btn-preview" class="btn-secondary py-1.5 px-4 text-xs font-mono font-bold flex items-center gap-2 transition-colors">
              <span class="i-lucide-eye w-4 h-4"></span> Preview
            </button>
            <button id="btn-publish" class="btn-primary py-1.5 px-4 text-xs">Publish</button>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto p-8 md:p-12">
          <div class="max-w-3xl mx-auto space-y-6">
            <input type="text" id="article-title" placeholder="Article Title" class="w-full text-3xl font-sans font-bold text-neutral-900 placeholder:text-neutral-600 border-none focus:outline-none focus:ring-0 bg-transparent px-0">
            
            <div class="grid grid-cols-2 gap-6">
              <div>
                <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest mb-2">Category</label>
                <input type="text" id="article-category" placeholder="e.g. Engineering" class="w-full bg-neutral-500 border border-neutral-200 px-4 py-3 text-sm focus:border-brand-primary focus:outline-none transition-all">
              </div>
              <div>
                <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest mb-2">Read Time (Mins)</label>
                <input type="number" id="article-readtime" placeholder="5" class="w-full bg-neutral-500 border border-neutral-200 px-4 py-3 text-sm focus:border-brand-primary focus:outline-none transition-all">
              </div>
            </div>

            <div>
              <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest mb-2">Cover Image URL (From Media Library)</label>
              <input type="url" id="article-image" placeholder="https://res.cloudinary.com/..." class="w-full bg-neutral-500 border border-neutral-200 px-4 py-3 text-sm focus:border-brand-primary focus:outline-none transition-all">
            </div>

            <div class="flex items-center gap-3 bg-neutral-500 border border-neutral-200 px-4 py-3">
              <input type="checkbox" id="article-featured" class="w-4 h-4 text-brand-primary bg-white border-neutral-200 rounded focus:ring-brand-primary focus:ring-2 cursor-pointer">
              <label for="article-featured" class="text-sm font-sans font-medium text-neutral-700 cursor-pointer">Set as Featured Article (Shows at top of Blog)</label>
            </div>

            <div>
              <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest mb-2">Excerpt</label>
              <textarea id="article-excerpt" rows="2" placeholder="Brief summary of the article..." class="w-full bg-neutral-500 border border-neutral-200 px-4 py-3 text-sm focus:border-brand-primary focus:outline-none transition-all resize-none"></textarea>
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest">Content (Markdown)</label>
              </div>
              <textarea id="article-content" rows="15" placeholder="Write your content here using Markdown..." class="w-full font-mono bg-white border border-neutral-200 px-4 py-4 text-sm focus:border-brand-primary focus:outline-none transition-all"></textarea>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- AI Modal -->
  <div id="ai-modal" class="fixed inset-0 bg-neutral-900/50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white max-w-lg w-full mx-4 shadow-2xl relative flex flex-col overflow-hidden">
      <!-- Header -->
      <div class="px-8 py-6 border-b border-neutral-200 bg-white flex justify-between items-center">
        <h3 class="text-xl font-sans font-bold text-neutral-900 flex items-center gap-2">
          <span class="i-lucide-sparkles text-brand-primary"></span>
          AI Article Generator
        </h3>
        <button id="btn-close-ai" class="text-neutral-500 hover:text-neutral-900 transition-colors">
          <span class="i-lucide-x w-5 h-5"></span>
        </button>
      </div>
      
      <!-- Body -->
      <div class="p-8 flex flex-col gap-6">
        <div>
          <label class="block text-xs font-mono text-neutral-500 uppercase tracking-widest mb-2">Topic or Genre</label>
          <div class="flex gap-2">
            <input type="text" id="ai-topic" placeholder="e.g. Zero-Trust Architecture" class="flex-1 bg-white border border-neutral-200 px-4 py-3 text-sm focus:border-brand-primary focus:outline-none transition-all">
            <button id="btn-ai-suggest" class="bg-neutral-50 hover:bg-neutral-200 text-neutral-600 px-4 py-3 text-xs font-mono font-bold uppercase tracking-widest transition-colors flex items-center gap-2 whitespace-nowrap" title="Suggest Trending Topic">
              <span class="i-lucide-lightbulb w-4 h-4"></span> Suggest
            </button>
          </div>
        </div>
        
        <div id="ai-loading" class="hidden flex-col items-center justify-center py-8">
          <div class="w-8 h-8 rounded-full border-2 border-neutral-200 border-t-brand-primary animate-spin mb-4"></div>
          <p class="text-sm font-mono text-neutral-500" id="ai-status-text">Generating technical content...</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="px-8 py-6 border-t border-neutral-200 bg-white flex justify-end">
        <button id="btn-ai-submit" class="btn-primary py-2 px-6 flex items-center gap-2">
          Generate <span class="i-lucide-arrow-right w-4 h-4"></span>
        </button>
      </div>
    </div>
  </div>

  <script>
    import { collection, query, orderBy, getDocs, addDoc, updateDoc, deleteDoc, doc, serverTimestamp } from "firebase/firestore";
    import { db } from "../../lib/firebase";

    let currentEditId: string | null = null;

    // UI Elements
    const viewList = document.getElementById('view-list');
    const viewEditor = document.getElementById('view-editor');
    const tbody = document.getElementById('articles-tbody');
    
    // Buttons
    const btnNew = document.getElementById('btn-new-article');
    const btnBack = document.getElementById('btn-back');
    const btnPublish = document.getElementById('btn-publish');
    const btnPreview = document.getElementById('btn-preview');
    const btnAiGenerate = document.getElementById('btn-ai-generate');
    const btnCloseAi = document.getElementById('btn-close-ai');
    const btnAiSuggest = document.getElementById('btn-ai-suggest');
    const btnAiSubmit = document.getElementById('btn-ai-submit');
    
    // Inputs
    const titleInput = document.getElementById('article-title') as HTMLInputElement;
    const categoryInput = document.getElementById('article-category') as HTMLInputElement;
    const readtimeInput = document.getElementById('article-readtime') as HTMLInputElement;
    const imageInput = document.getElementById('article-image') as HTMLInputElement;
    const featuredInput = document.getElementById('article-featured') as HTMLInputElement;
    const excerptInput = document.getElementById('article-excerpt') as HTMLTextAreaElement;
    const contentInput = document.getElementById('article-content') as HTMLTextAreaElement;
    const aiTopicInput = document.getElementById('ai-topic') as HTMLInputElement;

    const saveDraft = () => {
      const draft = {
        title: titleInput.value,
        category: categoryInput.value,
        readTime: readtimeInput.value,
        excerpt: excerptInput.value,
        content: contentInput.value,
        isFeatured: featuredInput ? featuredInput.checked : false
      };
      localStorage.setItem('primidac_blog_draft', JSON.stringify(draft));
    };

    [titleInput, categoryInput, readtimeInput, excerptInput, contentInput, featuredInput].forEach(input => {
      input?.addEventListener('input', saveDraft);
    });
    
    // Modal state
    const aiModal = document.getElementById('ai-modal');
    const aiLoading = document.getElementById('ai-loading');
    const aiStatusText = document.getElementById('ai-status-text');

    let articlesData: any[] = [];
    const GEMINI_API_KEY = import.meta.env.PUBLIC_GEMINI_API_KEY;

    // AI Functionality
    btnAiGenerate?.addEventListener('click', () => {
      aiModal?.classList.remove('hidden');
      aiModal?.classList.add('flex');
    });

    btnCloseAi?.addEventListener('click', () => {
      aiModal?.classList.add('hidden');
      aiModal?.classList.remove('flex');
    });

    async function callGemini(prompt: string, systemInstruction: string | null = null) {
      if (!GEMINI_API_KEY) {
        throw new Error("Missing PUBLIC_GEMINI_API_KEY in .env file.");
      }
      
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_API_KEY}`;
      const payload: any = {
        contents: [{ role: "user", parts: [{ text: prompt }] }]
      };
      
      if (systemInstruction) {
        payload.systemInstruction = {
          parts: [{ text: systemInstruction }]
        };
      }

      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      
      if (!res.ok) {
        const errText = await res.text();
        console.error("Gemini API Error Response:", errText);
        throw new Error(`Gemini API Error: ${res.status} - ${errText}`);
      }
      
      const data = await res.json();
      return data.candidates[0].content.parts[0].text;
    }

    btnAiSuggest?.addEventListener('click', async () => {
      try {
        btnAiSuggest.innerHTML = '<span class="w-3 h-3 rounded-full border-2 border-neutral-400 border-t-neutral-600 animate-spin"></span>';
        const prompt = "Suggest a single, highly engaging, trending technical topic for an enterprise engineering blog (e.g. distributed systems, hardware security, machine learning, cryptography). Return ONLY the topic title, nothing else.";
        const topic = await callGemini(prompt);
        aiTopicInput.value = topic.trim();
      } catch (err: any) {
        console.error("Failed to fetch suggestion", err);
        (window as any).showToast(err.message.includes("API Error") ? "Invalid API Key or Quota Exceeded" : "Failed to suggest topic", "error");
      } finally {
        btnAiSuggest.innerHTML = '<span class="i-lucide-lightbulb w-4 h-4"></span> Suggest';
      }
    });

    btnAiSubmit?.addEventListener('click', async () => {
      const topic = aiTopicInput.value.trim();
      if (!topic) return;

      try {
        (btnAiSubmit as HTMLButtonElement).disabled = true;
        aiLoading?.classList.remove('hidden');
        aiLoading?.classList.add('flex');
        if(aiStatusText) {
          aiStatusText.innerText = "Drafting perfect technical article...";
          aiStatusText.classList.remove('text-red-500');
          aiStatusText.classList.add('text-neutral-500');
        }
        const spinnerCircle = aiLoading?.querySelector('.animate-spin');
        if (spinnerCircle) spinnerCircle.classList.remove('hidden');

        const systemPrompt = `You are a distinguished principal engineer writing for Primidac.
Return your response EXACTLY in the following format:

TITLE: A captivating, technical title
CATEGORY: A 1-2 word technical genre
EXCERPT: A professional 2-sentence summary.
---
[The full markdown article starts here]`;
        const prompt = `Write an extensive, detailed, and mouth-watering technical article about: ${topic}.`;

        const responseText = await callGemini(prompt, systemPrompt);
        
        let titleStr = "";
        let categoryStr = "";
        let excerptStr = "";
        let contentStr = responseText;
        
        const parts = responseText.split('---');
        if (parts.length >= 2) {
          const header = parts[0];
          contentStr = parts.slice(1).join('---').trim();
          
          const titleMatch = header.match(/TITLE:\s*([^\n]+)/i);
          if (titleMatch) titleStr = titleMatch[1].trim();
          
          const catMatch = header.match(/CATEGORY:\s*([^\n]+)/i);
          if (catMatch) categoryStr = catMatch[1].trim();
          
          const excMatch = header.match(/EXCERPT:\s*([^\n]+)/i);
          if (excMatch) excerptStr = excMatch[1].trim();
        } else {
          titleStr = topic;
        }

        titleInput.value = titleStr.replace(/^["']|["']$/g, '');
        categoryInput.value = categoryStr.replace(/^["']|["']$/g, '');
        excerptInput.value = excerptStr.replace(/^["']|["']$/g, '');
        contentInput.value = contentStr;
        
        const words = (contentStr || "").split(/\s+/).length;
        readtimeInput.value = Math.max(1, Math.ceil(words / 200)).toString();

        (window as any).showToast("Article generated successfully!", "success");
        aiModal?.classList.add('hidden');
        aiModal?.classList.remove('flex');
        saveDraft();
      } catch (err: any) {
        console.error("AI Generation Error", err);
        if (aiStatusText) {
          aiStatusText.innerText = "Error: " + err.message;
          aiStatusText.classList.remove('text-neutral-500');
          aiStatusText.classList.add('text-red-500');
        }
        (window as any).showToast(err.message.includes("API Error") ? "Invalid API Key or Quota Exceeded" : err.message, "error");
        
        // Hide the spinner circle but keep the text
        const spinnerCircle = aiLoading?.querySelector('.animate-spin');
        if (spinnerCircle) spinnerCircle.classList.add('hidden');
        
        (btnAiSubmit as HTMLButtonElement).disabled = false;
      }
    });

    // Load Articles
    async function loadArticles() {
      try {
        const q = query(collection(db, "insights"), orderBy("createdAt", "desc"));
        const snapshot = await getDocs(q);
        articlesData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        renderList();
      } catch (error) {
        console.error("Error loading articles:", error);
        if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-red-500">Error loading data</td></tr>`;
      }
    }

    function renderList() {
      if (!tbody) return;
      tbody.innerHTML = '';

      if (articlesData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="px-6 py-12 text-center text-sm font-mono text-neutral-500">No articles published yet.</td></tr>`;
        return;
      }

      articlesData.forEach(article => {
        const date = article.createdAt ? new Date(article.createdAt.seconds * 1000).toLocaleDateString() : 'Draft';
        const tr = document.createElement('tr');
        tr.className = 'border-b border-neutral-100 hover:bg-white transition-colors group';
        
        tr.innerHTML = `
          <td class="px-6 py-4">
            <div class="font-sans font-bold text-sm text-neutral-900">${article.title}</div>
            <div class="text-[10px] text-neutral-500 font-mono mt-1">${article.category}</div>
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex items-center px-2 py-1 rounded bg-green-50 text-green-700 text-[10px] font-mono uppercase tracking-widest border border-green-200">Published</span>
          </td>
          <td class="px-6 py-4 text-xs font-mono text-neutral-500">
            ${date}
          </td>
          <td class="px-6 py-4 text-right">
            <button class="text-xs font-mono text-brand-primary hover:underline btn-edit" data-id="${article.id}">Edit</button>
            <button class="text-xs font-mono text-red-500 hover:underline ml-3 btn-delete" data-id="${article.id}">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // List Action Handlers
    tbody?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('btn-edit')) {
        const id = target.getAttribute('data-id');
        const article = articlesData.find(a => a.id === id);
        if (article) {
          currentEditId = id;
          titleInput.value = article.title || '';
          categoryInput.value = article.category || '';
          readtimeInput.value = article.readTime || '';
          if(imageInput) imageInput.value = article.coverImage || article.image || '';
          if(featuredInput) featuredInput.checked = !!article.isFeatured;
          excerptInput.value = article.excerpt || '';
          contentInput.value = article.content || '';
          
          const statusEl = document.getElementById('editor-status');
          if(statusEl) statusEl.innerText = 'Editing';
          if(btnPublish) btnPublish.innerText = 'Save Changes';
          
          viewList?.classList.add('hidden');
          viewEditor?.classList.remove('hidden');
          viewEditor?.classList.add('flex');
        }
      } else if (target.classList.contains('btn-delete')) {
        const id = target.getAttribute('data-id');
        if (confirm('Are you sure you want to delete this article? This action cannot be undone.')) {
          try {
            await deleteDoc(doc(db, "insights", id!));
            (window as any).showToast("Article deleted successfully", "success");
            await loadArticles();
          } catch(err) {
            console.error(err);
            (window as any).showToast("Failed to delete article", "error");
          }
        }
      }
    });

    btnNew?.addEventListener('click', () => {
      currentEditId = null;
      const statusEl = document.getElementById('editor-status');
      if(statusEl) statusEl.innerText = 'Draft';
      if(btnPublish) btnPublish.innerText = 'Publish';

      const savedDraft = localStorage.getItem('primidac_blog_draft');
      if (savedDraft) {
        try {
          const draft = JSON.parse(savedDraft);
          titleInput.value = draft.title || '';
          categoryInput.value = draft.category || '';
          readtimeInput.value = draft.readTime || '';
          excerptInput.value = draft.excerpt || '';
          contentInput.value = draft.content || '';
          if (featuredInput) featuredInput.checked = !!draft.isFeatured;
        } catch(e) {}
      } else {
        // Clear form
        titleInput.value = '';
        categoryInput.value = '';
        readtimeInput.value = '';
        if(imageInput) imageInput.value = '';
        if(featuredInput) featuredInput.checked = false;
        excerptInput.value = '';
        contentInput.value = '';
      }
      
      viewList?.classList.add('hidden');
      viewEditor?.classList.remove('hidden');
      viewEditor?.classList.add('flex');
    });

    btnBack?.addEventListener('click', () => {
      viewEditor?.classList.add('hidden');
      viewEditor?.classList.remove('flex');
      viewList?.classList.remove('hidden');
    });

    // Preview
    btnPreview?.addEventListener('click', () => {
      const previewData = {
        title: titleInput.value,
        category: categoryInput.value,
        readTime: readtimeInput.value,
        excerpt: excerptInput.value,
        content: contentInput.value,
        image: imageInput ? imageInput.value : '',
        isFeatured: featuredInput ? featuredInput.checked : false
      };
      
      sessionStorage.setItem('primidac_blog_preview', JSON.stringify(previewData));
      
      // Open preview in new tab
      window.open('/blog/preview', '_blank');
    });

    // Publish
    btnPublish?.addEventListener('click', async () => {
      if (!titleInput.value || !contentInput.value) {
        (window as any).showToast("Title and Content are required.", "error");
        return;
      }

      const originalText = btnPublish.innerText;
      btnPublish.innerText = "Publishing...";
      (btnPublish as HTMLButtonElement).disabled = true;

      try {
        // Generate a simple slug
        const slug = titleInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

        const articleData = {
          title: titleInput.value,
          slug: slug,
          category: categoryInput.value || 'Uncategorized',
          readTime: parseInt(readtimeInput.value) || 5,
          image: imageInput ? imageInput.value : '',
          coverImage: imageInput ? imageInput.value : '',
          isFeatured: featuredInput ? featuredInput.checked : false,
          excerpt: excerptInput.value,
          content: contentInput.value,
          status: 'published'
        };

        if (currentEditId) {
          await updateDoc(doc(db, "insights", currentEditId), articleData);
        } else {
          await addDoc(collection(db, "insights"), {
            ...articleData,
            createdAt: serverTimestamp()
          });
        }

        // Go back and reload
        (window as any).showToast("Article published successfully!", "success");
        localStorage.removeItem('primidac_blog_draft');
        
        viewEditor?.classList.add('hidden');
        viewEditor?.classList.remove('flex');
        viewList?.classList.remove('hidden');
        
        const skeletonHtml = Array(5).fill(0).map(() => `
          <tr class="border-b border-neutral-100 animate-pulse">
            <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-3/4"></div></td>
            <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-1/3"></div></td>
            <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-1/2"></div></td>
            <td class="px-6 py-4"><div class="h-4 bg-neutral-200 rounded w-16 ml-auto"></div></td>
          </tr>
        `).join('');
        tbody!.innerHTML = skeletonHtml;
        await loadArticles();

      } catch (error) {
        console.error("Error publishing:", error);
        (window as any).showToast("Failed to publish.", "error");
      } finally {
        btnPublish.innerText = originalText;
        (btnPublish as HTMLButtonElement).disabled = false;
      }
    });

    // Init
    viewList?.classList.remove('hidden');
    viewEditor?.classList.add('hidden');
    viewEditor?.classList.remove('flex');
    
    loadArticles();
  </script>
</AdminLayout>
