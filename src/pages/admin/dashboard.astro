---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <div class="p-8 md:p-12 max-w-6xl mx-auto w-full">
    
    <div class="flex justify-between items-end mb-12">
      <div>
        <h1 class="text-2xl font-sans font-bold text-neutral-900 mb-2">Platform Overview</h1>
        <p class="text-sm text-neutral-500 font-mono tracking-widest uppercase">Real-time telemetry</p>
      </div>
      <div class="text-xs font-mono text-neutral-500">
        Status: <span class="text-green-500">Operational</span>
      </div>
    </div>

    <!-- Analytics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      
      <!-- Page Views -->
      <div class="bg-white border border-neutral-200 p-6 flex flex-col relative overflow-hidden">
        <div class="flex justify-between items-start mb-6 relative z-10">
          <div class="w-8 h-8 rounded bg-brand-primary/10 text-brand-primary flex items-center justify-center">
            <span class="i-lucide-eye w-4 h-4"></span>
          </div>
          <span class="text-[10px] font-mono font-bold text-brand-primary uppercase tracking-widest bg-brand-primary/5 px-2 py-1">All Time</span>
        </div>
        <div class="relative z-10">
          <div class="text-3xl font-sans font-bold text-neutral-900 mb-1" id="stat-views">--</div>
          <div class="text-xs font-mono text-neutral-500 tracking-wider uppercase">Total Page Views</div>
        </div>
      </div>

      <!-- Leads -->
      <div class="bg-white border border-neutral-200 p-6 flex flex-col relative overflow-hidden">
        <div class="flex justify-between items-start mb-6 relative z-10">
          <div class="w-8 h-8 rounded bg-brand-primary/10 text-brand-primary flex items-center justify-center">
            <span class="i-lucide-users w-4 h-4"></span>
          </div>
          <span class="text-[10px] font-mono font-bold text-brand-primary uppercase tracking-widest bg-brand-primary/5 px-2 py-1">Inbox</span>
        </div>
        <div class="relative z-10">
          <div class="text-3xl font-sans font-bold text-neutral-900 mb-1" id="stat-leads">--</div>
          <div class="text-xs font-mono text-neutral-500 tracking-wider uppercase">Total Leads Captured</div>
        </div>
      </div>

      <!-- Articles -->
      <div class="bg-white border border-neutral-200 p-6 flex flex-col relative overflow-hidden">
        <div class="flex justify-between items-start mb-6 relative z-10">
          <div class="w-8 h-8 rounded bg-brand-primary/10 text-brand-primary flex items-center justify-center">
            <span class="i-lucide-file-text w-4 h-4"></span>
          </div>
          <span class="text-[10px] font-mono font-bold text-brand-primary uppercase tracking-widest bg-brand-primary/5 px-2 py-1">CMS</span>
        </div>
        <div class="relative z-10">
          <div class="text-3xl font-sans font-bold text-neutral-900 mb-1" id="stat-articles">--</div>
          <div class="text-xs font-mono text-neutral-500 tracking-wider uppercase">Published Insights</div>
        </div>
      </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Analytics Chart -->
      <div class="bg-white border border-neutral-200 p-6 md:p-8">
        <div class="flex justify-between items-center mb-6 border-b border-neutral-100 pb-4">
          <h2 class="text-sm font-bold font-sans text-neutral-900 uppercase tracking-wider">Traffic Analysis</h2>
          <select id="chart-range" class="text-[10px] font-mono border border-neutral-200 rounded px-2 py-1 bg-white text-neutral-600 focus:outline-none focus:border-brand-primary cursor-pointer">
            <option value="7">Last 7 Days</option>
            <option value="30">Last 30 Days</option>
            <option value="365">Last Year</option>
          </select>
        </div>
        <div class="relative h-64 w-full">
          <canvas id="traffic-chart"></canvas>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="bg-white border border-neutral-200 p-6 md:p-8">
        <h2 class="text-sm font-bold font-sans text-neutral-900 mb-6 uppercase tracking-wider border-b border-neutral-100 pb-4">Recent System Activity</h2>
        
        <div class="space-y-4 max-h-64 overflow-y-auto pr-2" id="activity-feed">
          <!-- Skeleton Loading -->
          <div class="animate-pulse flex flex-col gap-4">
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 rounded-full bg-neutral-200 mt-2 shrink-0"></div>
              <div class="space-y-2 flex-1">
                <div class="h-4 bg-neutral-200 rounded w-3/4"></div>
                <div class="h-3 bg-neutral-50 rounded w-1/4"></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 rounded-full bg-neutral-200 mt-2 shrink-0"></div>
              <div class="space-y-2 flex-1">
                <div class="h-4 bg-neutral-200 rounded w-1/2"></div>
                <div class="h-3 bg-neutral-50 rounded w-1/3"></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 rounded-full bg-neutral-200 mt-2 shrink-0"></div>
              <div class="space-y-2 flex-1">
                <div class="h-4 bg-neutral-200 rounded w-5/6"></div>
                <div class="h-3 bg-neutral-50 rounded w-1/5"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { collection, doc, getDocs, query, orderBy, limit, onSnapshot, where, getCountFromServer } from "firebase/firestore";
    import { db } from "../../lib/firebase";
    import Chart from 'chart.js/auto';

    async function initRealtimeStats() {
      // Global Page Views
      onSnapshot(doc(db, "analytics", "global"), (docSnap) => {
        const el = document.getElementById('stat-views');
        if (el) {
          el.innerText = docSnap.exists() ? (docSnap.data().totalViews || 0).toLocaleString() : '0';
        }
      });

      // Leads count
      try {
        const leadsCount = await getCountFromServer(collection(db, "leads"));
        const leadsEl = document.getElementById('stat-leads');
        if (leadsEl) leadsEl.innerText = leadsCount.data().count.toString();
      } catch (e) {
        console.error("Error getting leads count:", e);
      }

      // Articles count
      try {
        const insightsCount = await getCountFromServer(collection(db, "insights"));
        const articlesEl = document.getElementById('stat-articles');
        if (articlesEl) articlesEl.innerText = insightsCount.data().count.toString();
      } catch (e) {
        console.error("Error getting insights count:", e);
      }

      updateActivityFeed();
    }

    let trafficChart: any = null;

    async function initChart(days = 7) {
      const today = new Date();
      const labels: string[] = [];
      const data: number[] = [];
      const dateMap = new Map();
      
      const startDate = new Date();
      startDate.setDate(today.getDate() - (days - 1));
      const startStr = startDate.toISOString().split('T')[0];

      try {
        const q = query(collection(db, "analytics"), where("date", ">=", startStr));
        const snap = await getDocs(q);
        snap.forEach(doc => {
          dateMap.set(doc.data().date, doc.data().views || 0);
        });
      } catch(e) {
        console.error("Error fetching analytics", e);
      }

      if (days > 31) {
        const monthlyData = new Map();
        for (let i = days - 1; i >= 0; i--) {
          const d = new Date(today);
          d.setDate(d.getDate() - i);
          const monthStr = d.toLocaleDateString(undefined, { month: 'short', year: '2-digit' });
          const dateStr = d.toISOString().split('T')[0];
          
          if (!labels.includes(monthStr)) {
            labels.push(monthStr);
            monthlyData.set(monthStr, 0);
          }
          
          const views = dateMap.get(dateStr) || 0;
          monthlyData.set(monthStr, monthlyData.get(monthStr) + views);
        }
        labels.forEach(label => {
          data.push(monthlyData.get(label));
        });
      } else {
        for (let i = days - 1; i >= 0; i--) {
          const d = new Date(today);
          d.setDate(d.getDate() - i);
          const dateStr = d.toISOString().split('T')[0];
          
          if (days <= 7) {
            labels.push(d.toLocaleDateString(undefined, { weekday: 'short' }));
          } else {
            labels.push(d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }));
          }
          
          data.push(dateMap.get(dateStr) || 0);
        }
      }
      
      const canvas = document.getElementById('traffic-chart') as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let gradient;
        if (ctx) {
          // Adjust height based on assumed canvas height (approx 256px) for gradient
          gradient = ctx.createLinearGradient(0, 0, 0, 256);
          gradient.addColorStop(0, 'rgba(2, 27, 107, 0.2)');
          gradient.addColorStop(1, 'rgba(2, 27, 107, 0.0)');
        }

        if (trafficChart) {
          trafficChart.destroy();
        }

        trafficChart = new Chart(canvas, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: 'Page Views',
              data: data,
              borderColor: '#021B6B',
              backgroundColor: gradient || 'transparent',
              borderWidth: 1.5,
              pointRadius: 0,
              pointHoverRadius: 5,
              pointBackgroundColor: '#ffffff',
              pointBorderColor: '#021B6B',
              pointBorderWidth: 2,
              fill: true,
              tension: 0.3
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
              mode: 'index',
              intersect: false,
            },
            plugins: { 
              legend: { display: false },
              tooltip: {
                backgroundColor: '#0a0a0a',
                titleFont: { family: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace', size: 11 },
                bodyFont: { family: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace', size: 12 },
                padding: 12,
                displayColors: false,
                cornerRadius: 2
              }
            },
            scales: {
              y: { 
                beginAtZero: true, 
                grid: { color: '#f5f5f5', tickLength: 0 },
                border: { dash: [4, 4], display: false },
                ticks: {
                  font: { family: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace', size: 10 },
                  color: '#a3a3a3',
                  maxTicksLimit: 6,
                  padding: 10
                }
              },
              x: { 
                grid: { display: false },
                border: { display: false },
                ticks: {
                  font: { family: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace', size: 10 },
                  color: '#a3a3a3',
                  padding: 10
                }
              }
            }
          }
        });
      }
    }

    async function updateActivityFeed() {
      const feed = document.getElementById('activity-feed');
      if (!feed) return;
      
      try {
        const leadsQ = query(collection(db, "leads"), orderBy("createdAt", "desc"), limit(5));
        const leadsSnap = await getDocs(leadsQ);
        const insightsQ = query(collection(db, "insights"), orderBy("createdAt", "desc"), limit(5));
        const insightsSnap = await getDocs(insightsQ);
        
        let activities: any[] = [];
        
        leadsSnap.forEach(doc => {
          activities.push({
            type: 'lead',
            text: `New inquiry from ${doc.data().name}`,
            time: doc.data().createdAt?.seconds || 0
          });
        });
        
        insightsSnap.forEach(doc => {
          activities.push({
            type: 'insight',
            text: `Insight published: ${doc.data().title}`,
            time: doc.data().createdAt?.seconds || 0
          });
        });
        
        activities.sort((a, b) => b.time - a.time);
        activities = activities.slice(0, 5);
        
        if (activities.length === 0) {
          feed.innerHTML = `<div class="text-sm text-neutral-500 font-mono py-4">No recent activity.</div>`;
          return;
        }
        
        feed.innerHTML = activities.map(act => `
          <div class="flex items-start gap-4 py-3 border-b border-neutral-50 last:border-0">
            <div class="w-8 h-8 rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0 mt-1">
              <span class="i-lucide-${act.type === 'lead' ? 'user' : 'file-text'} w-4 h-4"></span>
            </div>
            <div>
              <p class="text-sm text-neutral-900">${act.text}</p>
              <p class="text-[10px] text-neutral-500 font-mono mt-1">${new Date(act.time * 1000).toLocaleString()}</p>
            </div>
          </div>
        `).join('');
        
      } catch (err) {
        console.error("Feed error", err);
      }
    }

    const rangeSelect = document.getElementById('chart-range') as HTMLSelectElement;
    if (rangeSelect) {
      rangeSelect.addEventListener('change', (e) => {
        const days = parseInt((e.target as HTMLSelectElement).value, 10);
        initChart(days);
      });
    }

    // Initialize
    initRealtimeStats();
    initChart(7);
  </script>
</AdminLayout>
