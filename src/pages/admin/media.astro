---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Media Library">
  <div class="h-full flex flex-col">
    <div class="p-6 md:p-8 border-b border-neutral-200 bg-white flex justify-between items-center shrink-0">
      <div>
        <h1 class="text-2xl font-bold font-sans text-neutral-900 tracking-tight">Media Library</h1>
        <p class="text-sm font-mono text-neutral-500 mt-1">Upload and manage images with Cloudinary.</p>
      </div>
      <div>
        <input type="file" id="file-upload" class="hidden" accept="image/*" multiple />
        <button id="btn-upload" class="btn-primary py-2 px-6">
          <span class="i-lucide-upload w-4 h-4 mr-2"></span>
          Upload Files
        </button>
      </div>
    </div>

    <div class="flex-1 overflow-auto p-6 md:p-8 bg-white">
      <div id="upload-progress" class="hidden mb-6 p-6 bg-white border border-neutral-200 shadow-sm relative overflow-hidden transition-all duration-300">
        <div class="flex items-center justify-between mb-3 relative z-10">
          <div class="flex items-center gap-3">
            <span class="i-lucide-upload-cloud w-4 h-4 text-brand-primary animate-pulse"></span>
            <span class="text-xs font-mono text-neutral-900 font-bold uppercase tracking-widest">Synchronizing Assets</span>
          </div>
          <span class="text-[10px] font-mono text-neutral-500 bg-neutral-50 px-2 py-1 rounded border border-neutral-200"><span id="upload-count">0</span> of <span id="upload-total">0</span></span>
        </div>
        <div class="w-full bg-neutral-50 h-1.5 rounded-full overflow-hidden relative z-10">
          <div id="upload-bar" class="h-full bg-brand-primary w-0 transition-all duration-500 ease-out"></div>
        </div>
      </div>

      <div id="media-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        <!-- Skeleton Loading -->
        {Array(12).fill(0).map((_) => (
          <div class="aspect-square bg-neutral-200 animate-pulse rounded border border-neutral-100"></div>
        ))}
      </div>
    </div>
  </div>

  <script>
    import { collection, query, orderBy, getDocs, addDoc, deleteDoc, doc, serverTimestamp } from "firebase/firestore";
    import { db } from "../../lib/firebase";

    const CLOUD_NAME = "dtgmjpkaj";
    const UPLOAD_PRESET = "primidacassets";

    const btnUpload = document.getElementById('btn-upload');
    const fileUpload = document.getElementById('file-upload') as HTMLInputElement;
    const mediaGrid = document.getElementById('media-grid');
    const uploadProgress = document.getElementById('upload-progress');
    const uploadCount = document.getElementById('upload-count');
    const uploadTotal = document.getElementById('upload-total');
    const uploadBar = document.getElementById('upload-bar');

    async function loadMedia() {
      if (!mediaGrid) return;
      try {
        const q = query(collection(db, "media"), orderBy("createdAt", "desc"));
        const snapshot = await getDocs(q);
        
        mediaGrid.innerHTML = '';
        
        if (snapshot.empty) {
          mediaGrid.innerHTML = `<div class="col-span-full py-12 text-center text-sm font-mono text-neutral-500">No media uploaded yet.</div>`;
          return;
        }

        snapshot.forEach((docSnap) => {
          const data = docSnap.data();
          const docId = docSnap.id;
          const url = data.url;
          const name = data.name || 'Image';
          
          const card = document.createElement('div');
          card.className = 'group relative aspect-square bg-white border border-neutral-200 rounded overflow-hidden cursor-pointer';
          card.innerHTML = `
            <img src="${url}" alt="${name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute inset-0 bg-neutral-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-center items-center gap-2">
              <button class="btn-copy text-xs font-mono bg-white text-neutral-900 px-3 py-1 rounded hover:bg-neutral-50" data-url="${url}">Copy URL</button>
              <button class="btn-delete text-xs font-mono bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600" data-id="${docId}">Delete</button>
            </div>
          `;
          mediaGrid.appendChild(card);
        });

        // Event delegation for dynamically added buttons
        mediaGrid.querySelectorAll('.btn-copy').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const url = (e.target as HTMLButtonElement).getAttribute('data-url');
            if (url) {
              navigator.clipboard.writeText(url);
              const originalText = (e.target as HTMLButtonElement).innerText;
              (e.target as HTMLButtonElement).innerText = 'Copied!';
              setTimeout(() => { (e.target as HTMLButtonElement).innerText = originalText; }, 2000);
            }
          });
        });

        mediaGrid.querySelectorAll('.btn-delete').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const docId = (e.target as HTMLButtonElement).getAttribute('data-id');
            if (docId) {
              window.showConfirm("Remove this file from your library?", async () => {
                try {
                  await deleteDoc(doc(db, "media", docId));
                  loadMedia();
                  window.showToast("File deleted successfully");
                } catch (err) {
                  console.error("Delete failed", err);
                  window.showToast("Failed to delete.", "error");
                }
              });
            }
          });
        });

      } catch (err) {
        console.error("Error loading media:", err);
        mediaGrid.innerHTML = `<div class="col-span-full py-12 text-center text-red-500">Error loading media.</div>`;
      }
    }

    btnUpload?.addEventListener('click', () => fileUpload?.click());

    // Image compression logic
    async function compressImage(file: File): Promise<Blob> {
      return new Promise((resolve) => {
        if (!file.type.startsWith('image/') || file.type === 'image/svg+xml' || file.type === 'image/gif') {
          resolve(file); // Don't compress SVGs, GIFs, or non-images
          return;
        }

        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (event) => {
          const img = new Image();
          img.src = event.target?.result as string;
          img.onload = () => {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;
            
            const MAX_WIDTH = 1920;
            const MAX_HEIGHT = 1080;
            
            if (width > height) {
              if (width > MAX_WIDTH) {
                height *= MAX_WIDTH / width;
                width = MAX_WIDTH;
              }
            } else {
              if (height > MAX_HEIGHT) {
                width *= MAX_HEIGHT / height;
                height = MAX_HEIGHT;
              }
            }
            
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0, width, height);
            
            canvas.toBlob((blob) => {
              resolve(blob as Blob);
            }, 'image/webp', 0.85); // Compress to WebP at 85% quality
          };
        };
      });
    }

    fileUpload?.addEventListener('change', async (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (!files || files.length === 0) return;

      if (uploadProgress && uploadCount && uploadTotal && uploadBar) {
        uploadProgress.classList.remove('hidden');
        uploadCount.innerText = '0';
        uploadTotal.innerText = files.length.toString();
        uploadBar.style.width = '0%';
      }

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        
        try {
          const compressedBlob = await compressImage(file);
          
          let newName = file.name;
          if (compressedBlob !== file) {
            newName = newName.substring(0, newName.lastIndexOf('.')) + '.webp';
          }

          // Upload to Cloudinary
          const formData = new FormData();
          formData.append("file", compressedBlob, newName);
          formData.append("upload_preset", UPLOAD_PRESET);
          
          const response = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, {
            method: "POST",
            body: formData
          });

          if (!response.ok) {
            throw new Error(`Cloudinary upload failed: ${response.statusText}`);
          }

          const data = await response.json();

          // Save link to Firestore
          await addDoc(collection(db, "media"), {
            name: newName,
            url: data.secure_url,
            public_id: data.public_id,
            createdAt: serverTimestamp()
          });

          // Update Progress Bar
          if (uploadCount && uploadBar) {
            uploadCount.innerText = (i + 1).toString();
            uploadBar.style.width = `${((i + 1) / files.length) * 100}%`;
          }

        } catch (err) {
          console.error("Upload failed for", file.name, err);
        }
      }

      setTimeout(() => {
        if (uploadProgress) uploadProgress.classList.add('hidden');
        fileUpload.value = ''; // Reset input
        loadMedia(); // Refresh grid
      }, 600);
    });

    // Init
    loadMedia();
  </script>
</AdminLayout>
