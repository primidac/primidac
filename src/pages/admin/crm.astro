---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="CRM Pipeline">
  <div class="h-full flex flex-col">
    <!-- Header -->
    <div class="p-6 md:p-8 border-b border-neutral-200 bg-white shrink-0">
      <h1 class="text-2xl font-bold font-sans text-neutral-900 tracking-tight">CRM Pipeline</h1>
      <p class="text-sm font-mono text-neutral-500 mt-1">Manage leads and active projects.</p>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 bg-white p-6 md:p-8 overflow-x-auto">
      
      <div class="flex gap-6 h-full min-w-max pb-4" id="kanban-board">
        <!-- Columns will be injected here -->
        <!-- Skeleton Kanban -->
        {Array(3).fill(0).map(() => (
          <div class="w-80 shrink-0 flex flex-col h-full bg-neutral-50/50 rounded-lg p-4 animate-pulse">
            <div class="h-4 bg-neutral-200 rounded w-1/3 mb-4"></div>
            <div class="space-y-3">
              <div class="bg-white p-4 rounded border border-neutral-200 shadow-sm">
                <div class="h-4 bg-neutral-200 rounded w-3/4 mb-3"></div>
                <div class="h-3 bg-neutral-50 rounded w-1/2"></div>
              </div>
              <div class="bg-white p-4 rounded border border-neutral-200 shadow-sm">
                <div class="h-4 bg-neutral-200 rounded w-2/3 mb-3"></div>
                <div class="h-3 bg-neutral-50 rounded w-1/3"></div>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>

  <script>
    import { collection, query, orderBy, onSnapshot, doc, updateDoc } from "firebase/firestore";
    import { db } from "../../lib/firebase";

    const board = document.getElementById('kanban-board');
    let leadsData: any[] = [];

    const COLUMNS = [
      { id: 'new', label: 'New Lead' },
      { id: 'contacted', label: 'In Discussion' },
      { id: 'proposal', label: 'Proposal Sent' },
      { id: 'active', label: 'Active Project' },
      { id: 'completed', label: 'Completed' }
    ];

    function renderBoard() {
      if (!board) return;
      board.innerHTML = '';

      COLUMNS.forEach(col => {
        const columnLeads = leadsData.filter(l => (l.status || 'new') === col.id);
        
        const colEl = document.createElement('div');
        colEl.className = 'w-80 flex flex-col h-full bg-neutral-50/50 rounded-lg border border-neutral-200 overflow-hidden shrink-0';
        
        colEl.innerHTML = `
          <div class="p-4 border-b border-neutral-200 bg-neutral-50 flex justify-between items-center shrink-0">
            <h3 class="text-xs font-bold font-mono uppercase tracking-widest text-neutral-700">${col.label}</h3>
            <span class="text-[10px] font-mono bg-white px-2 py-0.5 rounded border border-neutral-200 text-neutral-500">${columnLeads.length}</span>
          </div>
          <div class="flex-1 p-3 overflow-y-auto space-y-3" id="col-${col.id}">
            ${columnLeads.length === 0 ? `<div class="text-center py-6 text-xs font-mono text-neutral-500">No projects</div>` : ''}
          </div>
        `;
        
        board.appendChild(colEl);

        const listContainer = colEl.querySelector(`#col-${col.id}`);
        columnLeads.forEach(lead => {
          const date = lead.createdAt ? new Date(lead.createdAt.seconds * 1000).toLocaleDateString() : 'N/A';
          const card = document.createElement('div');
          card.className = 'bg-white p-4 border border-neutral-200 rounded shadow-sm hover:border-brand-primary transition-colors cursor-pointer group';
          
          let optionsHtml = COLUMNS.map(c => `<option value="${c.id}" ${c.id === (lead.status || 'new') ? 'selected' : ''}>${c.label}</option>`).join('');

          card.innerHTML = `
            <div class="flex justify-between items-start mb-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-brand-primary bg-brand-primary/10 px-2 py-0.5 rounded">${lead.source === 'start_project' ? 'Project' : 'Contact'}</span>
              <span class="text-[10px] font-mono text-neutral-500">${date}</span>
            </div>
            <h4 class="font-bold font-sans text-sm text-neutral-900 mb-1">${lead.name}</h4>
            <p class="text-xs text-neutral-500 truncate mb-4">${lead.email}</p>
            
            <select class="status-select w-full text-xs font-mono border border-neutral-200 rounded px-2 py-1.5 bg-white text-neutral-600 focus:outline-none focus:border-brand-primary" data-id="${lead.id}">
              ${optionsHtml}
            </select>
          `;
          listContainer?.appendChild(card);
        });
      });

      // Attach event listeners to selects
      document.querySelectorAll('.status-select').forEach(select => {
        select.addEventListener('change', async (e) => {
          const target = e.target as HTMLSelectElement;
          const leadId = target.getAttribute('data-id');
          const newStatus = target.value;
          
          if (leadId) {
            target.disabled = true;
            try {
              await updateDoc(doc(db, "leads", leadId), {
                status: newStatus,
                updatedAt: new Date().toISOString()
              });
            } catch (err) {
              console.error("Failed to update status", err);
              window.showToast("Failed to update status", "error");
              target.disabled = false;
            }
          }
        });
      });
    }

    // Subscribe to leads in real-time
    const q = query(collection(db, "leads"), orderBy("createdAt", "desc"));
    onSnapshot(q, (snapshot) => {
      leadsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      renderBoard();
    }, (error) => {
      console.error("Error loading leads:", error);
      if (board) board.innerHTML = `<div class="p-8 text-red-500">Error loading data.</div>`;
    });
  </script>
</AdminLayout>
