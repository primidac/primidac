---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Settings">
  <div class="p-6 sm:p-10 relative max-w-4xl min-h-full flex flex-col">
    
    <div class="mb-10">
      <h1 class="text-3xl text-neutral-900 font-bold mb-2 font-display">Account Settings</h1>
      <p class="text-neutral-600 text-sm max-w-lg leading-relaxed">
        Manage your workspace profile, billing details, and active tool subscriptions.
      </p>
    </div>

    <div class="space-y-8 relative z-10">
      
      <!-- Profile Section -->
      <section class="bg-white border border-neutral-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-6 border-b border-neutral-100 pb-4">Profile Information</h2>
        
        <div class="flex items-start gap-6">
          <div id="settings-avatar" class="w-20 h-20 rounded-2xl bg-neutral-100 overflow-hidden border border-neutral-200 shadow-sm flex items-center justify-center shrink-0">
            <span class="i-lucide-user w-8 h-8 text-neutral-400"></span>
          </div>
          <div class="space-y-4 flex-1">
            <div>
              <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest mb-1.5">Email Address</label>
              <div id="settings-email" class="text-sm font-medium text-neutral-900 bg-neutral-50 px-4 py-2 rounded-md border border-neutral-100 inline-block">Loading...</div>
            </div>
            <div>
              <label class="block text-[10px] font-mono text-neutral-500 uppercase tracking-widest mb-1.5">Workspace Role</label>
              <div class="text-sm font-bold text-brand-primary bg-brand-primary/10 border border-brand-primary/20 px-3 py-1 rounded-full inline-block">Admin</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Danger Zone -->
      <section class="bg-white border border-red-100 rounded-2xl p-6 md:p-8 shadow-[0_4px_20px_rgba(220,38,38,0.03)]">
        <h2 class="text-lg font-bold text-red-600 mb-2">Danger Zone</h2>
        <p class="text-xs text-neutral-500 mb-6">Irreversible and destructive actions.</p>
        
        <div class="flex items-center justify-between border-t border-red-50 pt-6 mt-4">
          <div>
            <div class="text-sm font-bold text-neutral-900">Sign Out</div>
            <div class="text-xs text-neutral-500 mt-1">Log out of your current session on this device.</div>
          </div>
          <button id="logout-btn" class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded-md text-xs font-bold uppercase tracking-wide transition-colors flex items-center gap-2">
            <span class="i-lucide-log-out w-4 h-4"></span> Logout
          </button>
        </div>
      </section>
      
    </div>
  </div>

  <script>
    import { onAuthStateChanged, signOut } from "firebase/auth";
    import { auth } from "../../lib/firebase";
    import { blobatar } from "blobatar";

    document.addEventListener('DOMContentLoaded', () => {
      // Profile Hydration
      onAuthStateChanged(auth, (user) => {
        if (user && user.email) {
          const emailDisplay = document.getElementById('settings-email');
          const avatarDisplay = document.getElementById('settings-avatar');
          
          if (emailDisplay) emailDisplay.textContent = user.email;
          if (avatarDisplay) avatarDisplay.innerHTML = blobatar(user.email);
        }
      });

      // Logout Logic
      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            await signOut(auth);
            window.location.href = '/login';
          } catch (error) {
            console.error("Error signing out:", error);
          }
        });
      }
    });
  </script>
</DashboardLayout>
