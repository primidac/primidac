---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — Primidac · Product Engineer"
  description="Start a conversation with Primidac regarding product engineering, cyber security audits, or AI automations."
>
  <main class="section-padding">
    <div class="page-container max-w-3xl">
      
      <!-- Section Tag -->
      <div class="section-tag mb-6">
        <span class="text-accent font-bold">// 01</span>
        <span>GET IN TOUCH</span>
      </div>

      <h1 class="h1-display mb-6">
        Let’s talk about your product.
      </h1>

      <p class="body-editorial text-ink/80 mb-12">
        I welcome discussions around product engineering, application security reviews, workflow automation, and technical architecture.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        
        <!-- Direct channels -->
        <div class="md:col-span-5 space-y-6">
          <div class="p-6 card-surface space-y-5 text-sm font-mono">
            <div>
              <span class="text-xs text-muted block mb-1">// EMAIL</span>
              <a href="mailto:hello@primidac.com" class="link-underline text-ink font-semibold">
                hello@primidac.com
              </a>
            </div>
            <div>
              <span class="text-xs text-muted block mb-1">// CALL</span>
              <a href="https://calendly.com" target="_blank" rel="noopener noreferrer" class="link-underline text-ink font-semibold">
                Book 30-min call &rarr;
              </a>
            </div>
            <div>
              <span class="text-xs text-muted block mb-1">// SECURITY CONTACT</span>
              <a href="mailto:security@primidac.com" class="link-underline text-ink">
                security@primidac.com
              </a>
            </div>
          </div>
        </div>

        <!-- 3-Field Message Form -->
        <div class="md:col-span-7">
          <form class="card-surface space-y-6" action="mailto:hello@primidac.com" method="GET">
            <div>
              <label for="contact-name" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">
                Name
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Jane Smith"
                class="w-full px-4 py-3 bg-surface border-hairline rounded-md font-sans text-sm text-ink placeholder:text-muted/60 focus:outline-none focus:border-accent"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">
                Email
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="jane@company.com"
                class="w-full px-4 py-3 bg-surface border-hairline rounded-md font-sans text-sm text-ink placeholder:text-muted/60 focus:outline-none focus:border-accent"
              />
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-mono uppercase tracking-wider text-muted mb-2">
                Message
              </label>
              <textarea
                id="contact-message"
                name="body"
                rows="5"
                required
                placeholder="Tell me about what you're building..."
                class="w-full px-4 py-3 bg-surface border-hairline rounded-md font-sans text-sm text-ink placeholder:text-muted/60 focus:outline-none focus:border-accent resize-none"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full">
              Transmit Message &rarr;
            </button>
          </form>
        </div>

      </div>

    </div>
  </main>
</Layout>
