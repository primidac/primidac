---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Engineering Dispatch — Technical Notes & Publications"
  description="Technical writing, project notes, and research findings from across Primidac's spheres."
>
  <div class="bg-surface-base min-h-screen w-full relative overflow-hidden">
    <!-- Structured Dot Grid Background -->
    <div
      class="absolute inset-0 z-0 pointer-events-none opacity-40"
      style="background-image: radial-gradient(#d4d4d8 1px, transparent 1px); background-size: 24px 24px;"
    >
      <!-- Gradient mask to fade out the dots towards the bottom -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-surface-base/80 to-surface-base"
      >
      </div>
    </div>

    <!-- Hero Section -->
    <section
      class="relative z-10 pt-28 md:pt-40 pb-12 md:pb-16 px-6 md:px-12 max-w-[1440px] mx-auto border-b border-neutral-200/50"
    >
      <div class="max-w-[1200px] gsap-hero-stagger">
        <div
          class="inline-flex items-center gap-3 px-3 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-mono text-neutral-600 uppercase tracking-widest mb-8 md:mb-12 shadow-sm"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-neutral-400"></span>
          Insights & Publications
        </div>
        <h1
          class="text-[40px] sm:text-[52px] md:text-7xl lg:text-[100px] leading-[1.05] md:leading-[1] tracking-tight font-sans font-bold text-neutral-900 mb-8 md:mb-12 hyphens-auto break-words"
        >
          Engineering<br />Dispatch.
        </h1>
        <p
          class="text-base sm:text-xl md:text-3xl text-neutral-600 leading-snug font-medium max-w-4xl"
        >
          Technical writing, architectural deep-dives, and research findings
          from across our engineering spheres.
        </p>
      </div>
    </section>

    <!-- Main Content Area -->
    <section
      class="relative z-10 py-16 md:py-24 px-6 md:px-12 max-w-[1440px] mx-auto"
    >
      <div class="structural-grid">
        <!-- Sidebar Filters -->
        <aside class="col-span-12 lg:col-span-3 mb-12 lg:mb-0" data-reveal>
          <div class="sticky top-28">
            <h3 class="text-mono-tech mb-6 pb-4 border-b-layout">
              Research Domains
            </h3>
            <ul
              class="space-y-3 font-sans text-sm font-medium"
              id="category-list"
            >
              <li>
                <a
                  href="#"
                  class="flex items-center justify-between text-brand-primary group"
                >
                  <span>All Publications</span>
                  <span
                    class="text-xs font-mono text-brand-primary/50 group-hover:text-brand-primary transition-colors"
                    id="total-count">--</span
                  >
                </a>
              </li>
              <div class="animate-pulse space-y-4 pt-4">
                <div class="h-4 bg-neutral-200 rounded w-3/4"></div>
                <div class="h-4 bg-neutral-200 rounded w-1/2"></div>
                <div class="h-4 bg-neutral-200 rounded w-5/6"></div>
              </div>
            </ul>
          </div>
        </aside>

        <!-- Articles Column -->
        <div class="col-span-12 lg:col-span-9 lg:pl-12">
          <!-- Featured Article -->
          <div class="mb-16" data-reveal>
            <h2 class="text-mono-tech mb-6 pb-4 border-b-layout">
              Featured Paper
            </h2>

            <div id="featured-article-container">
              <!-- Skeleton Loading -->
              <div
                class="group block bg-white border border-neutral-200 overflow-hidden animate-pulse"
              >
                <div class="grid grid-cols-1 md:grid-cols-2">
                  <div
                    class="h-64 md:h-auto bg-neutral-200 border-b md:border-b-0 md:border-r border-neutral-200 relative"
                  >
                  </div>
                  <div class="p-8 md:p-12 flex flex-col justify-center">
                    <div class="h-3 w-1/4 bg-neutral-200 rounded mb-6"></div>
                    <div class="h-8 w-3/4 bg-neutral-300 rounded mb-4"></div>
                    <div class="h-4 w-full bg-neutral-200 rounded mb-2"></div>
                    <div class="h-4 w-5/6 bg-neutral-200 rounded mb-8"></div>
                    <div class="h-3 w-1/3 bg-neutral-200 rounded mt-auto"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Articles Grid -->
          <div class="mb-12">
            <h2 class="text-mono-tech mb-6 pb-4 border-b-layout" data-reveal>
              Recent Insights
            </h2>

            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-6"
              id="articles-grid"
              data-stagger
            >
              <!-- Skeleton Loading -->
              {
                Array(4)
                  .fill(0)
                  .map(() => (
                    <div class="bg-white border border-neutral-200 p-8 flex flex-col h-full animate-pulse">
                      <div class="h-3 w-1/3 bg-neutral-200 rounded mb-4" />
                      <div class="h-6 w-3/4 bg-neutral-200 rounded mb-3" />
                      <div class="h-16 w-full bg-neutral-50 rounded mb-6 flex-grow" />
                      <div class="h-3 w-1/4 bg-neutral-200 rounded" />
                    </div>
                  ))
              }
            </div>

            <div class="mt-12 flex justify-center" data-reveal>
              <button class="btn-secondary"> Load More Archives </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    import {
      collection,
      query,
      orderBy,
      getDocs,
      where,
    } from "firebase/firestore";
    import { db } from "../../lib/firebase";

    async function loadArticles() {
      const grid = document.getElementById("articles-grid");
      const featuredContainer = document.getElementById(
        "featured-article-container",
      );
      const categoryList = document.getElementById("category-list");
      const totalCount = document.getElementById("total-count");
      if (!grid || !featuredContainer || !categoryList) return;

      const recentSection = grid.closest(".mb-12") as HTMLElement | null;

      try {
        // Fetch without orderBy to avoid needing a composite index
        const q = query(
          collection(db, "insights"),
          where("status", "==", "published"),
        );
        const snapshot = await getDocs(q);

        const articles: any[] = [];
        snapshot.forEach((docSnap) => {
          articles.push(docSnap.data());
        });

        if (articles.length === 0) {
          featuredContainer.innerHTML = `
            <div class="p-16 text-center border border-neutral-200 bg-white shadow-sm">
              <div class="w-16 h-16 bg-brand-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="i-lucide-file-text w-6 h-6 text-brand-primary"></span>
              </div>
              <h3 class="text-xl font-sans font-bold text-neutral-900 mb-2">No publications yet</h3>
              <p class="text-sm font-sans text-neutral-500 max-w-md mx-auto">We haven't published any technical insights yet. Check back soon for research breakdowns and engineering notes.</p>
            </div>
          `;
          grid.innerHTML = "";
          if (recentSection) recentSection.style.display = "none";
          categoryList.innerHTML =
            '<li><span class="text-sm font-mono text-neutral-500">No domains available</span></li>';
          if (totalCount) totalCount.innerText = "0";
          return;
        }

        // Local sort by createdAt descending
        articles.sort((a, b) => {
          const aTime = a.createdAt
            ? typeof a.createdAt.toMillis === "function"
              ? a.createdAt.toMillis()
              : new Date(a.createdAt).getTime()
            : 0;
          const bTime = b.createdAt
            ? typeof b.createdAt.toMillis === "function"
              ? b.createdAt.toMillis()
              : new Date(b.createdAt).getTime()
            : 0;
          return bTime - aTime;
        });

        const categoryCounts: Record<string, number> = {};
        articles.forEach((article) => {
          const cat = article.category || "Uncategorized";
          categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
        });

        // Update Total Count
        if (totalCount) totalCount.innerText = articles.length.toString();

        // Render Categories
        const catKeys = Object.keys(categoryCounts).sort();
        let catHTML = `
          <li>
            <a href="#" class="flex items-center justify-between text-brand-primary group">
              <span>All Publications</span>
              <span class="text-xs font-mono text-brand-primary/50 group-hover:text-brand-primary transition-colors">${articles.length}</span>
            </a>
          </li>
        `;
        catKeys.forEach((cat) => {
          catHTML += `
            <li>
              <a href="#" class="flex items-center justify-between text-neutral-600 hover:text-neutral-900 group transition-colors">
                <span>${cat}</span>
                <span class="text-xs font-mono text-neutral-500 group-hover:text-neutral-900 transition-colors">${categoryCounts[cat] < 10 ? "0" + categoryCounts[cat] : categoryCounts[cat]}</span>
              </a>
            </li>
          `;
        });
        categoryList.innerHTML = catHTML;

        // Render Featured
        let featuredIndex = articles.findIndex((a) => a.isFeatured === true);
        const hasFeatured = featuredIndex !== -1;

        let gridStartIndex = 0;

        if (hasFeatured) {
          const featured = articles[featuredIndex];
          const fDate =
            featured.createdAt?.toDate().toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            }) || "Just now";

          let coverImgHTML = `
            <div class="h-64 md:h-auto bg-neutral-50 flex items-center justify-center border-b md:border-b-0 md:border-r border-neutral-200 relative overflow-hidden">
              <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 16px 16px;"></div>
              <span class="i-lucide-cpu w-16 h-16 text-neutral-600 transform group-hover:scale-110 transition-transform duration-700 ease-out"></span>
            </div>
          `;

          if (featured.coverImage || featured.image) {
            coverImgHTML = `
              <div class="h-64 md:h-auto border-b md:border-b-0 md:border-r border-neutral-200 relative overflow-hidden bg-neutral-50">
                <img src="${featured.coverImage || featured.image}" alt="Cover" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out" />
              </div>
            `;
          }

          featuredContainer.innerHTML = `
            <a href="/blog/${featured.slug}" class="group block bg-white border border-neutral-200 overflow-hidden hover:border-brand-primary/30 hover:shadow-lg transition-all duration-300">
              <div class="grid grid-cols-1 md:grid-cols-2 min-h-[300px]">
                ${coverImgHTML}
                <div class="p-8 md:p-12 flex flex-col justify-center">
                  <div class="flex items-center gap-4 text-[10px] font-mono uppercase tracking-widest text-neutral-500 mb-6">
                    <span class="text-brand-primary">${featured.category || "Uncategorized"}</span>
                    <span>&mdash;</span>
                    <span>${fDate}</span>
                  </div>
                  <h3 class="text-2xl md:text-3xl font-sans font-bold text-neutral-900 leading-tight tracking-tight mb-4 group-hover:text-brand-primary transition-colors">
                    ${featured.title}
                  </h3>
                  <p class="text-body-sm mb-8 line-clamp-3">
                    ${featured.excerpt || ""}
                  </p>
                  <div class="mt-auto inline-flex items-center text-xs font-sans font-bold tracking-[0.1em] uppercase text-neutral-900 group-hover:text-brand-primary transition-colors">
                    Read Publication <span class="ml-2 font-normal group-hover:translate-x-1 transition-transform">→</span>
                  </div>
                </div>
              </div>
            </a>
          `;

          // Remove featured article from grid rendering
          articles.splice(featuredIndex, 1);
        } else {
          // Hide featured section entirely
          const featuredSection = featuredContainer.closest(
            ".mb-16",
          ) as HTMLElement;
          if (featuredSection) featuredSection.style.display = "none";
        }

        // Render Grid
        grid.innerHTML = "";
        if (articles.length === 0) {
          if (recentSection) recentSection.style.display = "none";
          return;
        }

        for (let i = 0; i < articles.length; i++) {
          const article = articles[i];
          const date =
            article.createdAt?.toDate().toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            }) || "Just now";

          const card = document.createElement("a");
          card.href = `/blog/${article.slug}`;
          card.className =
            "group block bg-white border border-neutral-200 overflow-hidden hover:border-brand-primary/30 hover:shadow-lg transition-all duration-300 flex flex-col h-full";

          let imgHTML = "";
          if (article.coverImage || article.image) {
            imgHTML = `
              <div class="h-48 w-full border-b border-neutral-200 overflow-hidden relative bg-neutral-50 shrink-0">
                <img src="${article.coverImage || article.image}" alt="Cover" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out" />
              </div>
            `;
          }

          card.innerHTML = `
            ${imgHTML}
            <div class="p-8 flex flex-col flex-grow">
              <div class="flex items-center gap-4 text-[10px] font-mono uppercase tracking-widest text-neutral-500 mb-4">
                <span class="text-brand-primary">${article.category || "Uncategorized"}</span>
                <span>&mdash;</span>
                <span>${date}</span>
              </div>
              <h3 class="text-xl font-sans font-bold text-neutral-900 leading-tight tracking-tight mb-3 group-hover:text-brand-primary transition-colors">
                ${article.title}
              </h3>
              <p class="text-body-sm mb-6 flex-grow line-clamp-3">
                ${article.excerpt || ""}
              </p>
              <div class="mt-auto inline-flex items-center text-[10px] font-sans font-bold tracking-[0.1em] uppercase text-neutral-900 group-hover:text-brand-primary transition-colors">
                Read <span class="ml-2 font-normal group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          `;
          grid.appendChild(card);
        }
      } catch (err) {
        console.error("Error loading articles:", err);
        featuredContainer.innerHTML = `
          <div class="p-16 text-center border border-red-100 bg-red-50/30">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="i-lucide-alert-circle w-6 h-6 text-red-500"></span>
            </div>
            <h3 class="text-xl font-sans font-bold text-neutral-900 mb-2">Data Integrity Error</h3>
            <p class="text-sm font-sans text-neutral-500 max-w-md mx-auto">The secure link to our publication database was interrupted. This is being investigated by our systems team.</p>
          </div>
        `;
        grid.innerHTML = "";
        if (recentSection) recentSection.style.display = "none";
        categoryList.innerHTML =
          '<li><span class="text-sm font-mono text-red-400">Sync Failed</span></li>';
        if (totalCount) totalCount.innerText = "--";
      }
    }

    document.addEventListener("DOMContentLoaded", loadArticles);
    // Execute immediately in case DOM is already loaded
    if (
      document.readyState === "interactive" ||
      document.readyState === "complete"
    ) {
      loadArticles();
    }
  </script>
</Layout>
