---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');
---

<Layout title="Tools — Primidac Technology" description="Practical software for real business problems.">
  <main class="bg-surface-base min-h-screen relative overflow-hidden pt-32 pb-32">
    
    <!-- Massive Watermark Background -->
    <div class="absolute inset-0 flex items-center justify-center overflow-hidden pointer-events-none select-none opacity-[0.03] fixed top-0">
      <div class="whitespace-nowrap font-tech font-bold text-[18vw] tracking-widest uppercase text-transparent bg-clip-text bg-gradient-to-b from-black to-transparent" style="-webkit-text-stroke: 2px rgba(0,0,0,0.15);">
        TOOLS
      </div>
    </div>
    
    <!-- Bionic Grid Overlay -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.02] mix-blend-overlay z-0" style="background-image: linear-gradient(#E4E6EB 1px, transparent 1px), linear-gradient(90deg, #E4E6EB 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="page-container relative z-10 px-6 lg:px-12">
      
      <!-- Tech-Heavy Hero Section -->
      <div class="max-w-4xl mb-24 mt-12 relative">
        <div class="inline-flex items-center gap-4 mb-6">
          <div class="h-[1px] w-12 bg-brand-primary opacity-80"></div>
          <span class="text-[10px] font-sans font-bold text-brand-primary uppercase tracking-[0.2em]">Internal_Systems</span>
        </div>
        <h1 class="font-display font-bold text-5xl md:text-7xl text-neutral-900 tracking-tighter mb-8 leading-[1.1]">
          Tools we're building
        </h1>
        <p class="text-lg md:text-xl text-neutral-700 font-sans max-w-2xl leading-relaxed">
          Practical software for real business problems.
        </p>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-20">
        {tools.map((tool) => (
          <a href={`/tools/${tool.slug}`} class="group block relative">
            <div class="bg-white backdrop-blur-md border border-neutral-200 rounded-sm p-6 lg:p-8 h-full flex flex-col transition-all duration-500 hover:-translate-y-1.5 hover:shadow-lg hover:border-neutral-300 hover:bg-neutral-100">
              
              <div class="flex justify-between items-start mb-8">
                <span class="text-[10px] font-sans font-bold tracking-[0.1em] text-neutral-500 group-hover:text-brand-primary transition-colors border border-neutral-200 rounded-sm px-2.5 py-1 bg-neutral-50 group-hover:border-brand-primary/30 uppercase">
                  {tool.data.category}
                </span>
                <span class="text-mono-tech text-[10px] text-neutral-500 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-neutral-200 group-hover:bg-[#10B981] group-hover:animate-pulse transition-colors"></span>
                  {tool.data.status}
                </span>
              </div>
              
              <h2 class="font-display font-semibold text-2xl text-neutral-900 mb-4 group-hover:text-neutral-900 transition-colors">{tool.data.title}</h2>
              <p class="text-sm font-sans text-neutral-600 leading-relaxed flex-grow mb-10">{tool.data.description}</p>
              
              <div class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-500 group-hover:text-brand-primary flex items-center gap-2 mt-auto transition-colors">
                Explore <span class="group-hover:translate-x-1 transition-transform opacity-0 group-hover:opacity-100">&rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
