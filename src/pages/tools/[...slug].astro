---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(tool => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { Content } = await tool.render();
---

<Layout title={`${tool.data.title} — Primidac Technology`} description={tool.data.description}>
  <article class="page-container py-24 md:py-32 max-w-4xl">
    <a href="/tools" class="inline-flex items-center gap-2 text-mono-tech text-brand-primary hover:text-brand-deep mb-12">
      &larr; Back to Tools
    </a>
    
    <div class="mb-16 border-b-layout pb-8">
      <div class="flex items-center gap-4 mb-6">
        <span class="struct-badge">{tool.data.category}</span>
        <span class="text-mono-tech">Status: {tool.data.status}</span>
      </div>
      <h1 class="text-display-hero text-neutral-900 mb-6">{tool.data.title}</h1>
      <p class="text-body-lg text-neutral-700">{tool.data.description}</p>
      
      {tool.data.url && (
        <a href={tool.data.url} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8">
          Visit Tool <span aria-hidden="true">&nearr;</span>
        </a>
      )}
    </div>

    <div class="prose prose-neutral max-w-none prose-headings:font-sans prose-headings:font-bold prose-h2:text-3xl prose-h3:text-2xl prose-a:text-brand-primary hover:prose-a:text-brand-deep">
      <Content />
    </div>

    <section class="mt-24 border-t-layout pt-16">
      <div class="bg-white p-8 border-layout flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div>
          <h3 class="text-heading-md mb-2">Have a problem worth solving?</h3>
          <p class="text-body-sm text-neutral-600">Let's discuss if we can build a solution for your business.</p>
        </div>
        <a href="/contact" class="btn-secondary whitespace-nowrap">Start a conversation</a>
      </div>
    </section>
  </article>
</Layout>
